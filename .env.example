# Copy to .env.local and fill in from your Supabase project:
# Dashboard → Project Settings → API Keys (use the *publishable* key, not the secret one).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public site origin for share images, sitemap and robots.txt (optional locally).
# NEXT_PUBLIC_SITE_URL=https://yearprint.example.com
